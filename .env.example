# Optional mDNS fallback. The TUI plugin discovers instances directly when installed.
OPENCODE_DISCOVERY=true

# Optional fixed OpenCode HTTP server, used alongside discovery when set.
# OPENCODE_URL=http://127.0.0.1:4096

# Optional. Strongly recommended if the OpenCode server is not otherwise isolated.
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=change-me

# Optional project directory. The hub normally learns the directory from session metadata.
# Set this if your OpenCode server is directory-scoped or question/permission routing needs it.
# OPENCODE_DIRECTORY=/home/me/projects/my-project

# Optional TUI plugin authentication overrides. Pocket creates the default token file automatically.
# OPENCODE_POCKET_TOKEN=change-me
# OPENCODE_POCKET_TOKEN_FILE=/home/me/.local/state/opencode-pocket/plugin-token

# Optional Web Push overrides. Pocket creates VAPID keys and subscription storage automatically.
# OPENCODE_POCKET_VAPID_SUBJECT=mailto:you@example.com
# OPENCODE_POCKET_VAPID_PUBLIC_KEY=
# OPENCODE_POCKET_VAPID_PRIVATE_KEY=
# OPENCODE_POCKET_VAPID_FILE=/home/me/.local/state/opencode-pocket/push-vapid.json
# OPENCODE_POCKET_PUSH_SUBSCRIPTIONS_FILE=/home/me/.local/state/opencode-pocket/push-subscriptions.json

# Optional ntfy destination. When configured, ntfy and browser notifications can be enabled independently.
# Use a long random topic or an authenticated topic. The public URL makes notifications open the affected session.
# OPENCODE_POCKET_NTFY_TOPIC=opencode-pocket-long-random-secret
# OPENCODE_POCKET_NTFY_URL=https://ntfy.sh
# OPENCODE_POCKET_NTFY_TOKEN=
# OPENCODE_POCKET_PUBLIC_URL=https://pocket.example.ts.net
# OPENCODE_POCKET_NOTIFICATION_SETTINGS_FILE=/home/me/.local/state/opencode-pocket/notification-settings.json

# Pocket listen address. Expose this loopback service through Tailscale Serve for phone access.
HOST=127.0.0.1
PORT=8787
